<?xml version="1.0" encoding="UTF-8"?>
<!--
  Baseline the legacy findings surfaced when SpotBugs was introduced.
  Keep SpotBugs failing the build for new, unsuppressed bug patterns while the
  broader existing backlog is handled incrementally.

  Documentation: https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter>

  <!-- High-priority families already present before SpotBugs was enabled. -->
  <Match>
    <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
  </Match>
  <Match>
    <Bug pattern="DM_BOXED_PRIMITIVE_FOR_PARSING"/>
  </Match>
  <Match>
    <Bug pattern="DM_BOXED_PRIMITIVE_TOSTRING"/>
  </Match>
  <Match>
    <Bug pattern="DM_DEFAULT_ENCODING"/>
  </Match>
  <Match>
    <Bug pattern="DMI_INVOKING_TOSTRING_ON_ARRAY"/>
  </Match>
  <Match>
    <Bug pattern="MS_SHOULD_BE_FINAL"/>
  </Match>
  <Match>
    <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
  </Match>
  <Match>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
  </Match>

  <!-- Remaining non-phase-1 legacy backlog after correctness/null cleanup. -->
  <Match>
    <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
  </Match>
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
