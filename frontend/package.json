{
  "name": "nci-meme-ui20",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng",
    "start": "npm run ng -- serve --host localhost --port 4200 --proxy-config proxy.config.json",
    "start:dev": "npm run ng -- serve --host localhost --port 4200 --proxy-config proxy.dev.config.json",
    "build": "npm run ng -- build --configuration production --progress=false",
    "build:dev": "npm run ng -- build --configuration development --progress=false",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "e2e": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open"
  },
  "dependencies": {
    "@angular/animations": "~20.3.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@types/jest": "^29.5.14",
    "cypress": "^15.0.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "node": "24.16.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3"
  }
}
