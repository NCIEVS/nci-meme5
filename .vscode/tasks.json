            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: run (debug) migration",
      "type": "shell",
      "command": "sh",
      "args": [
        "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8",
