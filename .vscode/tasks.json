{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gradle: explodeWar",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": [
        "clean",
        "explodeWar",
        "-Prun.config.label=umls"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "tomcat: deploy exploded as /umls-server-rest",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "rm -rf /opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest /opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest.war && ln -s ${workspaceFolder}/build/exploded /opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest"
      ],
      "dependsOn": "gradle: explodeWar",
      "problemMatcher": []
    },
    {
      "label": "tomcat: run (debug)",
      "type": "shell",
      "command": "sh",
      "args": [
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=${input:umlsConfigFile}",
          "JPDA_ADDRESS": "8001",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": [
        "tomcat: stop",
        "tomcat: deploy exploded as /umls-server-rest"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: run (debug) ncimeta",
      "type": "shell",
      "command": "sh",
      "args": [
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=/Users/deborahshapiro/Code/workspace-meme/meme-jdk17/config/config.ncimeta.properties",
          "JPDA_ADDRESS": "8001",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": [
        "tomcat: stop",
        "tomcat: deploy exploded as /umls-server-rest"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: run (debug) sample",
      "type": "shell",
      "command": "sh",
      "args": [
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=/Users/deborahshapiro/Code/workspace-meme/meme-jdk17/config/config.sample.properties",
          "JPDA_ADDRESS": "8001",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": [
        "tomcat: stop",
        "tomcat: deploy exploded as /umls-server-rest"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: run (debug) migration",
      "type": "shell",
      "command": "sh",
      "args": [
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=/Users/deborahshapiro/Code/workspace-meme/meme-jdk17/config/config.migration.properties",
          "JPDA_ADDRESS": "8001",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": [
        "tomcat: stop",
        "tomcat: deploy exploded as /umls-server-rest"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: stop",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh stop || true"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "umlsConfigFile",
      "type": "promptString",
      "description": "Path to the run.config.umls properties file",
      "default": "/Users/deborahshapiro/Code/workspace-meme/meme-jdk17/config/config.ncimeta.properties"
    }
  ]
}
