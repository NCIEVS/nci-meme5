{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gradle: explodeWar",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"${workspaceFolder}/config/local/setenv.sh\" && \"${workspaceFolder}/gradlew\" clean explodeWar"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "tomcat: deploy exploded as /umls-server-rest",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "rm -rf \"/opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest\" \"/opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest.war\" && ln -s \"${workspaceFolder}/build/exploded\" \"/opt/homebrew/opt/tomcat@10/libexec/webapps/umls-server-rest\""
      ],
      "dependsOn": "gradle: explodeWar",
      "problemMatcher": []
    },
    {
      "label": "tomcat: run (debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"${workspaceFolder}/config/local/setenv.sh\" && export JPDA_ADDRESS=8001 JPDA_TRANSPORT=dt_socket && cd \"/opt/homebrew/opt/tomcat@10/libexec\" && bin/catalina.sh jpda run"
      ],
      "dependsOn": [
        "tomcat: stop",
        "tomcat: deploy exploded as /umls-server-rest"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: stop",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "/opt/homebrew/opt/tomcat@10/libexec/bin/catalina.sh stop || true"
      ],
      "options": {
        "cwd": "/opt/homebrew/opt/tomcat@10/libexec"
      },
      "problemMatcher": []
    },
    {
      "label": "admin: reindex ProjectJpa (server down)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source \"${workspaceFolder}/config/local/setenv.sh\" && \"${workspaceFolder}/gradlew\" adminReindex -Pindexed.objects=ProjectJpa -Pserver=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
