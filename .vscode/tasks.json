{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gradle: explodeWar",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": [
        "explodeWar"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "tomcat: deploy exploded as /umls-server-rest",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "rm -rf /Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8/webapps/umls-server-rest && ln -s ${workspaceFolder}/build/exploded /Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8/webapps/umls-server-rest"
      ],
      "dependsOn": "gradle: explodeWar",
      "problemMatcher": []
    },
    {
      "label": "tomcat: run (debug)",
      "type": "shell",
      "command": "sh",
      "args": [
        "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=${input:umlsConfigFile}",
          "JPDA_ADDRESS": "8000",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": "tomcat: deploy exploded as /umls-server-rest",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
    {
      "label": "tomcat: run (debug) ncimeta",
      "type": "shell",
      "command": "sh",
      "args": [
        "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8/bin/catalina.sh",
        "jpda",
        "run"
      ],
      "options": {
        "cwd": "/Users/shapirod2/Code/workspace-terminology-service-jdk17/apache-tomcat-10.1.8",
        "env": {
          "CATALINA_OPTS": "-Drun.config.umls=/Users/shapirod2/Config/meme-jdk17/config/config.ncimeta.properties",
          "JPDA_ADDRESS": "8000",
          "JPDA_TRANSPORT": "dt_socket"
        }
      },
      "dependsOn": "tomcat: deploy exploded as /umls-server-rest",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".*"
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Using CATALINA_BASE:.*",
            "endsPattern": ".*Server startup in .* milliseconds.*"
          }
        }
      ]
    },
